# Fonte de dados do front-end.
#   mock → dados em memória (padrão; nenhuma configuração extra necessária)
#   rest → consome a API do back-end definida em VITE_API_URL
VITE_DATA_SOURCE=mock

# Base URL da API quando VITE_DATA_SOURCE=rest (sem barra no final).
# Ex.: https://api.sosales.com  ou  http://localhost:3333
VITE_API_URL=

# (Opcional) Latência artificial do mock em ms, para exercitar os estados de
# carregamento durante o desenvolvimento. Ex.: 600
VITE_MOCK_LATENCY=0
